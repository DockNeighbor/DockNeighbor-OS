# What the station image's build adds to station/openwrt/, as plain values (sourced by scripts/check-station-inputs.sh).
# station/openwrt/ is a byte-for-byte copy of the station build's openwrt/ directory at STATION_COMMIT.
STATION_COMMIT=bdbd4979180367e03e0d109038f5fe317139573c
# The radio's packages come from ChirpStack's OpenWrt feed (MIT), pinned to a commit, never a branch.
CHIRPSTACK_FEED=https://github.com/chirpstack/chirpstack-openwrt-feed.git^9cfc58d5b30c7851ac15aa8a01144dfafecb1b0c
