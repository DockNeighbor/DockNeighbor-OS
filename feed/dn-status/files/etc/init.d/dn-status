#!/bin/sh /etc/rc.common
# The read-only status page on :80 (owner ruling 2026-10-05). Its OWN uhttpd instance: the image keeps the system
# uhttpd disabled, and the hub's "local administration off" stops that system service, never this one, so the page
# stays up with SSH off. It serves one static page and one read-only CGI, and nothing else.
START=95
USE_PROCD=1

start_service() {
	procd_open_instance status
	# -n 3: at most three requests at once; -t 10: a CGI that hangs is cut off; no -i/-l: no other interpreter.
	procd_set_param command /usr/sbin/uhttpd -f -h /www/dn-status -x /cgi-bin -n 3 -t 10 -p 0.0.0.0:80
	procd_set_param respawn
	procd_close_instance
}
