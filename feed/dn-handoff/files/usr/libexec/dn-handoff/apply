#!/bin/sh
# dn-handoff: turn the brand-neutral /etc/dn/site.json (handoff/README.md) into this firmware's config, so a
# router flashed from its vendor firmware comes back on the same LAN address, access point, uplink and LTE modem
# settings, with the same admin password. Runs from uci-defaults at first boot, before the network starts.
# Exit 0 = applied (or nothing to apply); non-zero = keep the uci-defaults script and retry next boot.
SITE=/etc/dn/site.json
RESULT=/etc/dn/handoff.result

note() {
	# logd is not running yet at uci-defaults time, so the kernel log carries it into logread, and the
	# result file keeps the outcome for the agent and for support. Never secrets.
	echo "dn-handoff: $*" > /dev/kmsg 2>/dev/null
	echo "$*" > "$RESULT"
}

# A failure must leave nothing staged: a later uci-defaults script's `uci commit` would otherwise commit
# half of this site. The site file stays, so the next boot retries from a clean start.
fail() {
	for c in network wireless dhcp firewall; do uci -q revert "$c"; done
	[ -f /tmp/dn-handoff.shadow ] && cp /tmp/dn-handoff.shadow /etc/shadow
	note "failed: $*"
	exit 1
}

# Every uci write is checked: a write that fails must never be reported as applied. The message names the
# option but never its value (values include Wi-Fi keys).
u() { uci "$@" || fail "uci $1 ${2%%=*}"; }
# jshn prints "WARNING: Variable ... does not exist" on STDOUT for an absent optional object.
has() { json_select "$1" >/dev/null 2>&1; }

[ -f "$SITE" ] || exit 0
. /usr/share/libubox/jshn.sh
. /usr/lib/dn-net/uplink.sh || fail "dn-net's uplink.sh is missing"
json_load_file "$SITE" || fail "site file is not JSON"
json_get_var v v
[ "$v" = 1 ] || fail "unknown site version '$v'"

json_get_var country country
lan_ip=""
if has lan; then
	json_get_vars ip mask
	lan_ip=$ip
	[ -n "$ip" ] && u set network.lan.ipaddr="$ip"
	[ -n "$mask" ] && u set network.lan.netmask="$mask"
	json_select ..
fi

# Wi-Fi, only when the site has any: create the radio sections if the first-boot detect has not run yet.
# use_radio BAND sets $radio to this board's radio for that band (default 2g): on a dual-band board the site's
# 2.4 GHz access point must not land on the 5 GHz radio (the GL-X750's radio0), where the boat's 2.4 GHz-only
# devices can't join it. A board without that band (a single-band board) uses its first radio.
radio=""; enabled_radios=" "
use_radio() {
	case "${1:-2g}" in 2g|5g|6g) ;; *) fail "unknown Wi-Fi band '$1'" ;; esac
	uci -q show wireless | grep -q '=wifi-device$' || wifi config
	_all=$(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p')
	radio=""
	for _r in $_all; do [ "$(uci -q get "wireless.$_r.band")" = "${1:-2g}" ] && { radio=$_r; break; }; done
	[ -n "$radio" ] || radio=$(echo "$_all" | head -1)
	[ -n "$radio" ] || fail "no radio"
	case "$enabled_radios" in *" $radio "*) return 0 ;; esac
	u set wireless.$radio.disabled=0
	u set wireless.$radio.channel=auto
	[ -n "$country" ] && u set wireless.$radio.country="$country"
	enabled_radios="$enabled_radios$radio "
}

ap=""
if has ap; then
	json_get_vars ssid enc key band
	use_radio "$band"
	ap=$ssid
	uci -q delete wireless.dn_ap
	u set wireless.dn_ap=wifi-iface
	u set wireless.dn_ap.device=$radio
	u set wireless.dn_ap.mode=ap
	u set wireless.dn_ap.network=lan
	u set wireless.dn_ap.ssid="$ssid"
	u set wireless.dn_ap.encryption="${enc:-psk2}"
	u set wireless.dn_ap.key="$key"
	json_select ..
	# OpenWrt's default access point (named OpenWrt, open) is replaced, not left alongside.
	uci -q delete wireless.default_$radio
fi

uplink=""
if has uplink; then
	json_get_vars type ssid enc key role band
	if [ "$type" = wifi ]; then
		use_radio "$band"
		uplink=$ssid
		uci -q delete wireless.dn_uplink
		u set wireless.dn_uplink=wifi-iface
		u set wireless.dn_uplink.device=$radio
		u set wireless.dn_uplink.mode=sta
		u set wireless.dn_uplink.network=wwan
		u set wireless.dn_uplink.ssid="$ssid"
		u set wireless.dn_uplink.encryption="${enc:-psk2}"
		u set wireless.dn_uplink.key="$key"
		u set network.wwan=interface
		u set network.wwan.proto=dhcp
		u set network.wwan.metric=20
		# The role -> firewall rule lives in ONE place, dn-net's uplink.sh (lan: open like LAN; wan, the
		# default: restricted), shared with dn-net's uplink-join so it can't drift.
		dn_uplink_zone "${role:-wan}" wwan
		case $? in
			0) uplink="$ssid (${role:-wan})" ;;
			2) fail "unknown uplink role '$role'" ;;
			3) fail "no wan firewall zone" ;;
			*) fail "could not set the uplink's firewall" ;;
		esac
	fi
	json_select ..
fi

# The LTE modem (a board with a QMI modem, e.g. the GL-X750): upstream OpenWrt's netifd proto qmi (uqmi) on the
# modem's control device. An internet uplink like any other, so the wan zone, which drops input; a lower priority
# than a wired (metric 0) or Wi-Fi (20) uplink. The SIM PIN and APN password are written to uci, never reported.
lte=""
if has lte; then
	json_get_vars apn pincode auth username password pdptype disabled
	case "${auth:-none}" in none|pap|chap|both) ;; *) fail "unknown lte auth '$auth'" ;; esac
	case "${pdptype:-ipv4v6}" in ipv4|ipv6|ipv4v6) ;; *) fail "unknown lte pdptype '$pdptype'" ;; esac
	[ -z "$pincode" ] || echo "$pincode" | grep -qxE '[0-9]{4,8}' || fail "lte pincode is not 4 to 8 digits"
	if [ ! -f /lib/netifd/proto/qmi.sh ]; then
		# Settings for a modem this board doesn't have (sysupgrade refuses another board's image, so a site from
		# an LTE router rarely meets one). Failing would keep the whole site from applying on every boot.
		lte="skipped (no modem support in this image)"
	else
		uci -q delete network.lte
		u set network.lte=interface
		u set network.lte.proto=qmi
		u set network.lte.device=/dev/cdc-wdm0
		[ -n "$apn" ] && u set network.lte.apn="$apn"
		[ -n "$pincode" ] && u set network.lte.pincode="$pincode"
		if [ "${auth:-none}" != none ]; then
			u set network.lte.auth="$auth"
			[ -n "$username" ] && u set network.lte.username="$username"
			[ -n "$password" ] && u set network.lte.password="$password"
		fi
		# qmi.sh's own name for IPv4 is "ip".
		[ -n "$pdptype" ] && u set network.lte.pdptype="$([ "$pdptype" = ipv4 ] && echo ip || echo "$pdptype")"
		u set network.lte.metric=30
		[ "$disabled" = 1 ] && u set network.lte.disabled=1
		# The one role -> firewall rule (dn-net's uplink.sh): wan, restricted. qmi.sh gives its lte_4/lte_6
		# children this zone.
		dn_uplink_zone wan lte
		case $? in
			0) ;;
			3) fail "no wan firewall zone" ;;
			*) fail "could not set the LTE uplink's firewall" ;;
		esac
		lte="apn:${apn:-default}$([ "$disabled" = 1 ] && echo ",disabled")"
	fi
	json_select ..
fi

n=0
if has reservations; then
	i=1
	while has $i; do
		json_get_vars name mac ip
		s=$(uci add dhcp host) && [ -n "$s" ] || fail "uci add dhcp host"
		u set dhcp.$s.name="$name"
		u set dhcp.$s.mac="$mac"
		u set dhcp.$s.ip="$ip"
		json_select ..
		i=$((i + 1)); n=$((n + 1))
	done
	json_select ..
fi

json_get_var rootHash rootHash
if [ -n "$rootHash" ]; then
	case "$rootHash" in
		*[!A-Za-z0-9./\$]*) fail "admin password hash has unexpected characters" ;;
	esac
	# The | delimiter: a crypt hash contains / and $ but never | (checked just above).
	cp /etc/shadow /tmp/dn-handoff.shadow || fail "can't back up /etc/shadow"
	sed -i "s|^root:[^:]*:|root:$rootHash:|" /etc/shadow
	[ "$(sed -n 's/^root:\([^:]*\):.*/\1/p' /etc/shadow)" = "$rootHash" ] || fail "admin password not written"
fi

uci commit || fail "uci commit"
rm -f "$SITE" /tmp/dn-handoff.shadow
note "applied v1 lan=${lan_ip:-default} ap=${ap:-none} uplink=${uplink:-none} reservations=$n password=$([ -n "$rootHash" ] && echo carried || echo unchanged) lte=${lte:-none}"
exit 0
