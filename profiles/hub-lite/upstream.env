# Pinned upstream inputs for the hub-lite image. Every download is checked against these hashes.
# The OpenWrt hashes are from the release's sha256sums, whose signature was verified against the 24.10
# release key d310c6f2833e97f7 (github.com/openwrt/keyring usign/) when they were pinned, 2026-09-24.
OPENWRT_VERSION=24.10.8
OPENWRT_TARGET=ramips/mt76x8
# The commit the SDK's base feed (v24.10.8) must resolve to; the same pin as openwrt/VERSION.
OPENWRT_COMMIT=0b795ce79e23b553aa184080c390f9ce92a2b6d4
OPENWRT_BASE=https://downloads.openwrt.org/releases/24.10.8/targets/ramips/mt76x8
SDK_FILE=openwrt-sdk-24.10.8-ramips-mt76x8_gcc-13.3.0_musl.Linux-x86_64.tar.zst
SDK_SHA256=14e11075658b7186441ac853a91d6ba150cb7fadf948f7d4ce0946109322f8d3
IB_FILE=openwrt-imagebuilder-24.10.8-ramips-mt76x8.Linux-x86_64.tar.zst
IB_SHA256=c440389645a6ed77fc70997a20e0cbbdc194d9cf89327b4e3c8be4cc09eb3136
# The hub-lite, pinned by version AND sha256. The hash was checked against the Hub's SIGNED feed index (key in keys/,
# the Hub's hub-lite/package/brvg-feed.pub) when it was pinned. The feed is rolling, so its index lists only the
# newest version, but it keeps every .ipk, so a pin stays buildable after the Hub publishes. While the index
# still lists this version, the build requires the two hashes to agree.
HUB_LITE_FEED=https://github.com/DockNeighbor/DockNeighbor-Hub/releases/download/hub-lite-feed
HUB_LITE_FEED_KEY=b0ff2bec314c57d3
HUB_LITE_VERSION=0.18.8
HUB_LITE_SHA256=1c501f74c0ece42160f38bfe7846d18a190b2b2434a7bc14ec4c54586cb05c7a
# Plain upstream OpenWrt for the same board: CI runs the image check against it and requires it to FAIL,
# which proves the check can fail (from the same signed sha256sums).
UPSTREAM_IMAGE_FILE=openwrt-24.10.8-ramips-mt76x8-glinet_gl-mt300n-v2-squashfs-sysupgrade.bin
UPSTREAM_IMAGE_SHA256=22f3acbf2b6c5ec8fcedc07ed5e84e7b98be9f726a7fcbccdd6fe995e39d91f7
