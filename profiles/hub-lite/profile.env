# The DockNeighbor OS hub-lite image.
DN_OS_VERSION=0.1.0
DEVICE=glinet_gl-mt300n-v2
# The board name the vendor's sysupgrade checks; the image's metadata must list it.
BOARD=glinet,gl-mt300n-v2
# On top of the device defaults. No LuCI: no local web page, the apps are the interface.
PACKAGES="brvg-hub-lite dn-handoff -luci"
# The hub-lite runs its OWN uhttpd instance (port 8722). The system one would only serve an empty /www on :80.
DISABLED_SERVICES="uhttpd"
