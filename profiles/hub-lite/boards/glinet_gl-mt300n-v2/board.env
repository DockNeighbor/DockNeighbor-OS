# GL.iNet GL-MT300N-V2 (Mango): the hub-lite profile's first board. Pinned 2026-09-24, from OpenWrt 24.10.8's
# ramips/mt76x8 sha256sums, whose signature was verified against the 24.10 release key d310c6f2833e97f7
# (github.com/openwrt/keyring usign/).
BOARD_TITLE="GL.iNet GL-MT300N-V2"
OPENWRT_TARGET=ramips/mt76x8
OPENWRT_BASE=https://downloads.openwrt.org/releases/24.10.8/targets/ramips/mt76x8
# opkg architecture of this target's packages (profiles.json arch_packages): a compiled dn-* package is built per arch.
PKG_ARCH=mipsel_24kc
SDK_FILE=openwrt-sdk-24.10.8-ramips-mt76x8_gcc-13.3.0_musl.Linux-x86_64.tar.zst
SDK_SHA256=14e11075658b7186441ac853a91d6ba150cb7fadf948f7d4ce0946109322f8d3
IB_FILE=openwrt-imagebuilder-24.10.8-ramips-mt76x8.Linux-x86_64.tar.zst
IB_SHA256=c440389645a6ed77fc70997a20e0cbbdc194d9cf89327b4e3c8be4cc09eb3136
# Plain upstream OpenWrt for the same board: CI runs the image check against it and requires it to FAIL,
# which proves the check can fail (from the same signed sha256sums).
UPSTREAM_IMAGE_FILE=openwrt-24.10.8-ramips-mt76x8-glinet_gl-mt300n-v2-squashfs-sysupgrade.bin
UPSTREAM_IMAGE_SHA256=22f3acbf2b6c5ec8fcedc07ed5e84e7b98be9f726a7fcbccdd6fe995e39d91f7
# The ImageBuilder profile.
DEVICE=glinet_gl-mt300n-v2
# The board name the vendor's sysupgrade checks; the image's metadata must list it.
BOARD=glinet,gl-mt300n-v2
# The firmware partition: 0xf90000 (/proc/mtd on the device, 2026-09-24).
FIRMWARE_SIZE=0xf90000
# On top of the profile's PACKAGES.
BOARD_PACKAGES=""
# Level-2 (full OS) upgrades: the signed manifest for this profile + board, on a rolling release.
DN_OS_CHANNEL_URL=https://github.com/DockNeighbor/DockNeighbor-OS/releases/download/channel-hub-lite/glinet_gl-mt300n-v2.json
