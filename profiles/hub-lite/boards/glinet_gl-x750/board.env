# GL.iNet GL-X750 (Spitz), with its LTE modem (Quectel EC25 family, on USB inside the mPCIe slot). Pinned 2026-09-25,
# from OpenWrt 24.10.8's ath79/generic sha256sums, whose signature (sha256sums.sig) was verified against the 24.10
# release key d310c6f2833e97f7 (github.com/openwrt/keyring usign/). Device name, board name and image size are from
# that release's signed profiles.json (sha256 d5c45197436455ce315cfe252586f5b3bc529b5dd2630a40f2ad56f0a4ed3e23) and
# the v24.10.8 tree (target/linux/ath79/image/generic.mk, dts/qca9531_glinet_gl-x750.dts).
BOARD_TITLE="GL.iNet GL-X750"
OPENWRT_TARGET=ath79/generic
OPENWRT_BASE=https://downloads.openwrt.org/releases/24.10.8/targets/ath79/generic
PKG_ARCH=mips_24kc
SDK_FILE=openwrt-sdk-24.10.8-ath79-generic_gcc-13.3.0_musl.Linux-x86_64.tar.zst
SDK_SHA256=e46c4d0127061486ef4ce681f527f8a3980702011cafbf7801aff965a366dd8d
IB_FILE=openwrt-imagebuilder-24.10.8-ath79-generic.Linux-x86_64.tar.zst
IB_SHA256=29cc9bb6489af980fa7fd25873ae8605229d05343a3f0c107d924fefc87b6a3f
UPSTREAM_IMAGE_FILE=openwrt-24.10.8-ath79-generic-glinet_gl-x750-squashfs-sysupgrade.bin
UPSTREAM_IMAGE_SHA256=c833bc59abaa0dc5131d8a217d483c1f579189717c276fa80e8a44c845c146e7
DEVICE=glinet_gl-x750
BOARD=glinet,gl-x750
# The DTS's "firmware" partition, reg <0x060000 0xfa0000> on the 16 MiB NOR (= generic.mk's IMAGE_SIZE 16000k).
# The X750's 128 MiB SPI-NAND is not used by upstream OpenWrt.
FIRMWARE_SIZE=0xfa0000
# The LTE modem, the upstream way: QMI (uqmi, netifd proto qmi on /dev/cdc-wdm0; ModemManager would not fit).
# option: the modem's AT/NMEA serial ports. usb-acm: a USB GPS (the hub-lite's position source) on the USB port.
BOARD_PACKAGES="uqmi kmod-usb-net-qmi-wwan kmod-usb-serial-option kmod-usb-acm"
DN_OS_CHANNEL_URL=https://github.com/DockNeighbor/DockNeighbor-OS/releases/download/channel-hub-lite/glinet_gl-x750.json
